NODE_ENV=development

# Application ports
WEB_PORT=3000
API_PORT=3001
WORKER_HEALTH_PORT=3002

# Local Docker Compose credentials. Replace in non-local environments.
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
DATABASE_URL=postgresql://chat:chat_local_password@localhost:15432/chat?schema=public
REDIS_URL=redis://localhost:16379

# Browser-facing API origin. This value is public by design.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Phase 3: configure an OpenAI-compatible provider. Never expose the key to Next.js.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_DEFAULT_MODEL=deepseek-v4-flash

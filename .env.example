NODE_ENV=development

# 应用端口
WEB_PORT=3000
API_PORT=3001
WORKER_HEALTH_PORT=3002

# 本地 Docker Compose 凭据。非本地环境必须替换。
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
DATABASE_URL=postgresql://chat:chat_local_password@localhost:15432/chat?schema=public
TEST_DATABASE_URL=postgresql://chat:chat_local_password@localhost:15432/chat_test?schema=public
REDIS_URL=redis://localhost:16379

# 阶段 1：认证与会话。生产环境必须使用独立的高强度随机密钥并启用安全 Cookie。
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Next.js 服务端同源代理目标，不会进入浏览器 bundle。
API_INTERNAL_URL=http://localhost:3001

# 阶段 3：配置 OpenAI 兼容供应商。绝不能向 Next.js 暴露密钥。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_REASONING_MODE=enabled
LLM_REASONING_EFFORT=high
LLM_REQUEST_TIMEOUT_MS=600000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_USER_HASH_SECRET=replace-with-at-least-32-random-characters

# 阶段 4：Outbox 与异步 generation 队列。
GENERATION_QUEUE_PREFIX=chat:dev:queue
OUTBOX_DISPATCH_INTERVAL_MS=500
OUTBOX_DISPATCH_BATCH_SIZE=20
GENERATION_WORKER_CONCURRENCY=4
GENERATION_MAX_ATTEMPTS=3
GENERATION_RETRY_BASE_DELAY_MS=250
GENERATION_CANCEL_POLL_MS=200

# 阶段 5：用户级实时事件与 Worker 增量批处理。
EVENT_KEY_PREFIX=chat:dev:evt
EVENT_HEARTBEAT_MS=20000
USER_GENERATION_CONCURRENCY_LIMIT=2
GENERATION_DELTA_FLUSH_MS=30
GENERATION_DELTA_MAX_CHARS=384

# 阶段 7：有限事件重放、Redis 快照与 PostgreSQL checkpoint。
EVENT_RETENTION_MS=86400000
GENERATION_CHECKPOINT_INTERVAL_MS=750
GENERATION_CHECKPOINT_MAX_CHARS=3072

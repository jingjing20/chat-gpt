{
  "name": "concurrent-chat",
  "version": "0.1.0",
  "private": true,
  "description": "A resilient multi-conversation streaming AI chat application.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.0 <10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @chat/web dev",
    "dev:api": "pnpm --filter @chat/api start:dev",
    "dev:worker": "pnpm --filter @chat/worker start:dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:prepare": "pnpm --filter @chat/database db:test:prepare",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose -f infra/compose/compose.yml up -d",
    "infra:down": "docker compose -f infra/compose/compose.yml down",
    "infra:logs": "docker compose -f infra/compose/compose.yml logs -f",
    "db:generate": "pnpm --filter @chat/database db:generate",
    "db:migrate:deploy": "pnpm --filter @chat/database db:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @chat/database db:migrate:dev"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}

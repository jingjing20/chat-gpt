generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuditAction {
  USER_REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  SESSION_REFRESHED
  SESSION_REVOKED
  SESSION_REJECTED
}

enum AuditOutcome {
  SUCCEEDED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  CANCELLED
}

enum GenerationStatus {
  QUEUED
  STARTING
  STREAMING
  CANCEL_REQUESTED
  COMPLETED
  FAILED
  CANCELLED
}

enum GenerationAttemptStatus {
  STARTED
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String                  @unique @db.Citext
  passwordHash       String                  @map("password_hash")
  status             UserStatus              @default(ACTIVE)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshSessions    RefreshSession[]
  auditLogs          AuditLog[]
  conversations      Conversation[]
  conversationStates ConversationUserState[]
  messages           Message[]
  generations        Generation[]

  @@map("users")
}

model Conversation {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId   String                  @map("owner_user_id") @db.Uuid
  title         String                  @db.VarChar(120)
  lastMessageAt DateTime?               @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner         User                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  userStates    ConversationUserState[]
  messages      Message[]
  generations   Generation[]

  @@index([ownerUserId, updatedAt(sort: Desc), id(sort: Desc)])
  @@map("conversations")
}

model ConversationUserState {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  lastReadAt     DateTime?    @map("last_read_at") @db.Timestamptz(3)
  scrollOffset   Int          @default(0) @map("scroll_offset")
  hasUnread      Boolean      @default(false) @map("has_unread")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, archivedAt, updatedAt(sort: Desc)])
  @@map("conversation_user_states")
}

model Message {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId      String        @map("conversation_id") @db.Uuid
  authorUserId        String?       @map("author_user_id") @db.Uuid
  role                MessageRole
  status              MessageStatus @default(COMPLETED)
  content             String        @db.Text
  reasoningContent    String?       @map("reasoning_content") @db.Text
  parentMessageId     String?       @map("parent_message_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt         DateTime?     @map("completed_at") @db.Timestamptz(3)
  conversation        Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author              User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  parent              Message?      @relation("MessageParent", fields: [parentMessageId], references: [id], onDelete: SetNull)
  children            Message[]     @relation("MessageParent")
  requestedGeneration Generation?   @relation("GenerationRequestMessage")
  responseGeneration  Generation?   @relation("GenerationResponseMessage")

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("messages")
}

model Generation {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  conversationId     String              @map("conversation_id") @db.Uuid
  requestMessageId   String              @unique @map("request_message_id") @db.Uuid
  responseMessageId  String              @unique @map("response_message_id") @db.Uuid
  provider           String              @db.VarChar(50)
  model              String              @db.VarChar(100)
  status             GenerationStatus    @default(QUEUED)
  lastSequence       BigInt              @default(0) @map("last_sequence")
  checkpointSequence BigInt              @default(0) @map("checkpoint_sequence")
  idempotencyKey     String              @map("idempotency_key") @db.VarChar(100)
  requestHash        String              @map("request_hash") @db.Char(64)
  finishReason       String?             @map("finish_reason") @db.VarChar(50)
  providerRequestId  String?             @map("provider_request_id")
  errorCode          String?             @map("error_code") @db.VarChar(100)
  errorDetailSafe    String?             @map("error_detail_safe")
  writerToken        String?             @map("writer_token") @db.Uuid
  writerHeartbeatAt  DateTime?           @map("writer_heartbeat_at") @db.Timestamptz(3)
  cancelRequestedAt  DateTime?           @map("cancel_requested_at") @db.Timestamptz(3)
  startedAt          DateTime?           @map("started_at") @db.Timestamptz(3)
  firstTokenAt       DateTime?           @map("first_token_at") @db.Timestamptz(3)
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation       Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestMessage     Message             @relation("GenerationRequestMessage", fields: [requestMessageId], references: [id], onDelete: Cascade)
  responseMessage    Message             @relation("GenerationResponseMessage", fields: [responseMessageId], references: [id], onDelete: Cascade)
  attempts           GenerationAttempt[]
  usageRecords       UsageRecord[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([conversationId, createdAt])
  @@map("generations")
}

model GenerationAttempt {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  generationId       String                  @map("generation_id") @db.Uuid
  attemptNo          Int                     @map("attempt_no")
  status             GenerationAttemptStatus @default(STARTED)
  providerRequestId  String?                 @map("provider_request_id")
  writerToken        String?                 @map("writer_token") @db.Uuid
  startedAt          DateTime                @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime?               @map("ended_at") @db.Timestamptz(3)
  receivedFirstDelta Boolean                 @default(false) @map("received_first_delta")
  httpStatus         Int?                    @map("http_status")
  errorCode          String?                 @map("error_code") @db.VarChar(100)
  generation         Generation              @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@unique([generationId, attemptNo])
  @@map("generation_attempts")
}

model UsageRecord {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  generationId     String     @map("generation_id") @db.Uuid
  provider         String     @db.VarChar(50)
  model            String     @db.VarChar(100)
  promptTokens     Int?       @map("prompt_tokens")
  completionTokens Int?       @map("completion_tokens")
  totalTokens      Int?       @map("total_tokens")
  reasoningTokens  Int?       @map("reasoning_tokens")
  cacheHitTokens   Int?       @map("cache_hit_tokens")
  cacheMissTokens  Int?       @map("cache_miss_tokens")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  generation       Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId, createdAt])
  @@map("usage_records")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(50)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  type          String    @db.VarChar(100)
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.VarChar(500)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model RefreshSession {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  tokenHash     String          @unique @map("token_hash") @db.Char(64)
  userAgentHash String?         @map("user_agent_hash") @db.Char(64)
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?       @map("revoked_at") @db.Timestamptz(3)
  rotatedFromId String?         @unique @map("rotated_from_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFrom   RefreshSession? @relation("SessionRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo     RefreshSession? @relation("SessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@map("refresh_sessions")
}

model AuditLog {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  action    AuditAction
  outcome   AuditOutcome
  requestId String       @map("request_id") @db.VarChar(100)
  subjectId String?      @map("subject_id") @db.VarChar(100)
  ipHash    String?      @map("ip_hash") @db.Char(64)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

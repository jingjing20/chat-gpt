NODE_ENV=development

# 应用端口
WEB_PORT=3000
API_PORT=3001
WORKER_HEALTH_PORT=3002

# 本地 Docker Compose 凭据。非本地环境必须替换。
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
DATABASE_URL=postgresql://chat:chat_local_password@localhost:15432/chat?schema=public
TEST_DATABASE_URL=postgresql://chat:chat_local_password@localhost:15432/chat_test?schema=public
REDIS_URL=redis://localhost:16379

# 阶段 1：认证与会话。生产环境必须使用独立的高强度随机密钥并启用安全 Cookie。
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# 浏览器可见的 API 地址，该值按设计可以公开。
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# 阶段 3：配置 OpenAI 兼容供应商。绝不能向 Next.js 暴露密钥。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_DEFAULT_MODEL=deepseek-v4-flash
